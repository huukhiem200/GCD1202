<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta http-equiv="refresh" content="30">
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f3f7f9;
            color: #333;
            margin: 0;
            padding: 0;
        }
        h1 {
            text-align: center;
            color: #1a73e8;
            margin-bottom: 10px;
            font-size: 2.5em;
            letter-spacing: 2px;
            padding-top: 20px;
        }
        p {
            text-align: center;
            font-size: 1.2em;
            margin-bottom: 30px;
            color: #666;
        }
        .dropdown {
            text-align: center;
            margin: 30px 0;
        }
        label {
            font-size: 1.1em;
            color: #333;
            margin-right: 10px;
        }
        select {
            padding: 10px;
            font-size: 1em;
            border: 1px solid #ccc;
            border-radius: 25px;
            width: 220px;
            background-color: #fff;
            color: #333;
            transition: box-shadow 0.3s ease;
        }
        select:hover {
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        table {
            width: 90%;
            max-width: 1000px;
            margin: 20px auto;
            border-collapse: collapse;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid #e0e0e0;
            transition: background-color 0.3s ease;
        }
        th {
            background-color: #1a73e8;
            color: white;
            font-size: 1.1em;
            letter-spacing: 1px;
        }
        td {
            background-color: #ffffff;
            font-size: 1em;
            color: #555;
        }
        tr:hover td {
            background-color: #f1f3f4;
        }
        a {
            display: inline-block;
            text-align: center;
            margin: 20px auto;
            padding: 12px 30px;
            background-color: #ff5722;
            color: white;
            text-decoration: none;
            border-radius: 30px;
            font-size: 1.1em;
            letter-spacing: 1px;
            transition: background-color 0.3s ease, transform 0.3s ease;
        }
        a:hover {
            background-color: #e64a19;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
    
    <!-- Dropdown -->
    <div class="dropdown">
        <label for="options">Choose an option:</label>
        <%- droplist %>
    </div>

    <!-- Products table -->
    <%- products_table %>

    <a href="/logout">Logout</a>
</body>
</html>
